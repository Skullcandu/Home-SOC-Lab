# =====================================================================
# REGLAS PERSONALIZADAS DE SURICATA (IDS/IPS) - HOME SOC LAB
# Descripción: Conjunto de reglas para detectar reconocimiento de red,
# ataques de denegación de servicio (DoS) y explotación web (OWASP Top 10).
# =====================================================================

# --- 1. RECONOCIMIENTO DE RED Y ESCANEOS DE PUERTOS ---
alert icmp any any -> any any (msg:"ICMP Echo Request Detectado PING"; itype:8; icode:0; classtype:attempted-recon; sid:1000001; rev:1; priority:2;)
alert tcp any any -> any 22 (msg:"Escaneo de puerto SSH"; flags:S; classtype:attempted-login; sid:1000002; rev:1;)
alert tcp any any -> any 21 (msg:"Escaneo de puerto FTP (Inseguro)"; flags:S; classtype:attempted-login; sid:1000003; rev:1;)
alert tcp any any -> any 23 (msg:"Escaneo de puerto Telnet detectado"; flags:S; classtype:attempted-admin; sid:1000004; rev:1;)

# --- 2. DENEGACIÓN DE SERVICIO (DoS) ---
alert icmp any any -> any any (msg:"Posible Ping of Death (Paquete ICMP grande)"; dsize:>800; classtype:attempted-dos; sid:1000005; rev:1;)

# --- 3. DETECCIÓN DE HERRAMIENTAS OFENSIVAS ---
alert http any any -> any any (msg:"Escaneo Nmap Detectado por User-Agent"; content:"nmap"; http_user_agent; nocase; classtype:attempted-recon; sid:1000006; rev:1;)
alert http any any -> any any (msg:"Escaneo de directorios web con DirBuster/Gobuster"; content:"dirb"; http_user_agent; nocase; classtype:attempted-recon; sid:1000009; rev:1;)
alert http any any -> any any (msg:"Escaneo de vulnerabilidades web con Nikto"; content:"Nikto"; http_user_agent; nocase; classtype:attempted-recon; sid:1000011; rev:1;)

# --- 4. EXTRACCIÓN Y ATAQUES A APLICACIONES WEB (OWASP) ---
alert http any any -> any any (msg:"Intento de Inyeccion SQL (Comilla simple)"; content:"'"; http_uri; classtype:web-application-attack; sid:1000007; rev:1;)
alert http any any -> any any (msg:"Intento de ataque XSS detectado"; content:"<script>"; http_uri; nocase; classtype:web-application-attack; sid:1000008; rev:1;)
alert http any any -> any any (msg:"Intento de Path Traversal (/etc/passwd)"; content:"/etc/passwd"; http_uri; classtype:attempted-admin; sid:1000010; rev:1;)
